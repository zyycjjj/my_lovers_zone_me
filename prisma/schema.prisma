generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum EventType {
  tool_used
  signal_sent
}

model User {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(128)
  createdAt DateTime @default(now())

  signals Signal[]
  events  Event[]
  echoes  Echo[]
  photos  Photo[]
}

model Signal {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   @db.VarChar(10)
  mood      String   @db.VarChar(16)
  status    String   @db.VarChar(32)
  message   String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@unique([userId, date])
  @@index([userId, createdAt])
}

model Event {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      EventType
  toolKey   String    @db.VarChar(32)
  count     Int       @default(0)
  date      String    @db.VarChar(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, toolKey, date])
  @@index([userId, date])
}

model Echo {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Photo {
  id        Int      @id @default(autoincrement())
  userId    Int
  signalId  Int?
  url       String   @db.VarChar(512)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
