generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  me
  girlfriend
  test
  user
}

enum EventType {
  tool_used
  signal_sent
  button_used
}

enum AccountStatus {
  active
  disabled
}

enum AuthProvider {
  aliyun_number_auth
  sms_code
  wechat
  email
}

enum WorkspaceType {
  personal
  team
}

enum WorkspaceStatus {
  active
  archived
}

enum WorkspaceMemberRole {
  owner
  admin
  editor
}

enum WorkspaceMemberStatus {
  active
  invited
  removed
}

enum PaymentPlanKey {
  experience
  pro
  team
}

enum PaymentOrderStatus {
  pending
  paid
  activated
  rejected
  refunded
}

enum ContentAssetStatus {
  saved
  completed
  archived
}

enum SupportConnectionStatus {
  invited
  active
  removed
}

model Account {
  id              Int           @id @default(autoincrement())
  phone           String?       @unique @db.VarChar(32)
  phoneVerifiedAt DateTime?
  passwordHash    String?       @db.VarChar(128)
  passwordSalt    String?       @db.VarChar(64)
  displayName     String?       @db.VarChar(64)
  avatarUrl       String?       @db.VarChar(512)
  status          AccountStatus @default(active)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  identities       AuthIdentity[]
  sessions         AuthSession[]
  ownedWorkspaces  Workspace[]
  workspaceMembers WorkspaceMember[]
  profile          UserProfile?
  paymentOrders    PaymentOrder[]
  subscriptions    Subscription[]
  contentAssets    ContentAsset[]
  explosionCases   ExplosionCase[]
  supporterOwnedConnections SupportConnection[] @relation("SupportOwnerAccount")
  supporterAcceptedConnections SupportConnection[] @relation("SupporterAccount")
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  communityReactions CommunityReaction[]
}

model AuthIdentity {
  id             Int          @id @default(autoincrement())
  accountId      Int
  provider       AuthProvider
  providerUserId String?      @db.VarChar(128)
  providerPhone  String?      @db.VarChar(32)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([accountId, provider])

  @@map("authidentity")
}

model AuthSession {
  id           Int      @id @default(autoincrement())
  accountId    Int
  sessionToken String   @unique @db.VarChar(128)
  refreshToken String?  @unique @db.VarChar(128)
  expiredAt    DateTime
  lastActiveAt DateTime @default(now())
  ip           String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(512)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiredAt])

  @@map("authsession")
}

model Workspace {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(64)
  type           WorkspaceType
  ownerAccountId Int
  status         WorkspaceStatus @default(active)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner         Account           @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  profiles      UserProfile[]
  contentAssets ContentAsset[]

  @@index([ownerAccountId, type])
}

model WorkspaceMember {
  id          Int                   @id @default(autoincrement())
  workspaceId Int
  accountId   Int
  role        WorkspaceMemberRole
  status      WorkspaceMemberStatus @default(active)
  joinedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, accountId])
  @@index([accountId, status])

  @@map("workspacemember")
}

model UserProfile {
  id                    Int       @id @default(autoincrement())
  accountId             Int       @unique
  workspaceId           Int
  nickname              String?   @db.VarChar(64)
  businessRole          String?   @db.VarChar(64)
  industry              String?   @db.VarChar(64)
  currentGoal           String?   @db.VarChar(128)
  contentDirection      String?   @db.VarChar(128)
  targetPlatform        String?   @db.VarChar(64)
  experienceLevel       String?   @db.VarChar(32)
  contentStyle          String?   @db.VarChar(64)
  defaultAudience       String?   @db.VarChar(128)
  brandKeywords         String?   @db.VarChar(512)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  ProductProfile[]

  @@index([workspaceId])

  @@map("userprofile")
}

model User {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(128)
  role      UserRole?
  name      String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  signals       Signal[]
  events        Event[]
  echoes        Echo[]
  photos        Photo[]
  paymentOrders PaymentOrder[]
  contentAssets ContentAsset[]
  contentPlans  ContentPlan[]
  quotaUsages   QuotaUsage[]
  dailyCheckins DailyCheckin[]
  explosionCases ExplosionCase[]
  supportConnections SupportConnection[]
  sharedSupportAssets SupportSharedAsset[]
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  communityReactions CommunityReaction[]

  @@index([role])
}

model PaymentOrder {
  id          Int                @id @default(autoincrement())
  orderNo     String             @unique @db.VarChar(32)
  userId      Int
  accountId   Int?
  planKey     PaymentPlanKey
  amountFen   Int
  status      PaymentOrderStatus @default(pending)
  channel     String?            @db.VarChar(32)
  paymentRef  String?            @db.VarChar(128)
  proofNote   String?            @db.VarChar(255)
  adminNote   String?            @db.VarChar(255)
  paidAt      DateTime?
  activatedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, createdAt])

  @@map("paymentorder")
}

model Subscription {
  id        Int            @id @default(autoincrement())
  accountId Int
  planKey   PaymentPlanKey
  status    String         @default("active") @db.VarChar(16)
  startedAt DateTime       @default(now())
  expiredAt DateTime?
  orderId   Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status, expiredAt])
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appconfig")
}

model ContentAsset {
  id           Int                @id @default(autoincrement())
  userId       Int
  accountId    Int?
  workspaceId  Int?
  toolKey      String             @db.VarChar(32)
  title        String?            @db.VarChar(128)
  content      String             @db.LongText
  sourcePrompt String?            @db.LongText
  status       ContentAssetStatus @default(saved)
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  tasks     ContentPlanTask[]
  explosionCases ExplosionCase[]
  supportShares SupportSharedAsset[]
  communityPosts CommunityPost[]

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])

  @@map("contentasset")
}

model Signal {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   @db.VarChar(10)
  mood      String   @db.VarChar(16)
  status    String   @db.VarChar(32)
  message   String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@unique([userId, date])
  @@index([userId, createdAt])
}

model Event {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      EventType
  toolKey   String    @db.VarChar(32)
  count     Int       @default(0)
  date      String    @db.VarChar(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, toolKey, date])
  @@index([userId, date])
}

model Echo {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Photo {
  id        Int      @id @default(autoincrement())
  userId    Int
  signalId  Int?
  url       String   @db.VarChar(512)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ContentPlan {
  id          Int                   @id @default(autoincrement())
  userId      Int
  title       String                @db.VarChar(128)
  description String?               @db.VarChar(512)
  type        String                @default("weekly") @db.VarChar(32)
  status      String                @default("active") @db.VarChar(16)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ContentPlanTask[]

  @@index([userId, status, createdAt])
  @@index([userId, type])

  @@map("contentplan")
}

model ContentPlanTask {
  id            Int                   @id @default(autoincrement())
  planId        Int
  dayNumber     Int
  title         String                @db.VarChar(128)
  description   String?               @db.VarChar(512)
  hint          String?               @db.VarChar(256)
  toolKey       String?               @db.VarChar(32)
  status        String                @default("pending") @db.VarChar(16)
  completedAt   DateTime?
  assetId       Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  plan  ContentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  asset ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([planId, dayNumber])
  @@index([planId, status])

  @@map("contentplantask")
}

model QuotaUsage {
  id           Int      @id @default(autoincrement())
  userId       Int
  accountId    Int?
  planKey      String   @db.VarChar(32)
  quotaKey     String   @db.VarChar(64)
  amount       Int      @default(1)
  description  String?  @db.VarChar(256)
  refType      String?  @db.VarChar(32)
  refId        Int?
  balanceAfter Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, quotaKey, createdAt])
  @@index([accountId, createdAt])

  @@map("quotausage")
}

model ProductProfile {
  id            Int      @id @default(autoincrement())
  userProfileId Int
  name          String   @db.VarChar(128)
  category      String?  @db.VarChar(64)
  price         String?  @db.VarChar(32)
  sellingPoints String?  @db.VarChar(512)
  targetAudience String? @db.VarChar(256)
  platform      String?  @db.VarChar(64)
  notes         String?  @db.VarChar(512)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])

  @@map("productprofile")
}

model SupportConnection {
  id                 Int                     @id @default(autoincrement())
  ownerUserId        Int
  ownerAccountId     Int?
  supporterAccountId Int?
  supporterName      String                  @db.VarChar(64)
  supporterContact   String?                 @db.VarChar(128)
  inviteCode         String                  @unique @db.VarChar(32)
  note               String?                 @db.VarChar(255)
  status             SupportConnectionStatus @default(invited)
  acceptedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  ownerUser        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerAccount     Account? @relation("SupportOwnerAccount", fields: [ownerAccountId], references: [id], onDelete: SetNull)
  supporterAccount Account? @relation("SupporterAccount", fields: [supporterAccountId], references: [id], onDelete: SetNull)
  sharedAssets     SupportSharedAsset[]

  @@index([ownerUserId, status, createdAt])
  @@index([ownerAccountId, status])
  @@index([supporterAccountId, status])

  @@map("supportconnection")
}

model SupportSharedAsset {
  id           Int      @id @default(autoincrement())
  connectionId Int
  assetId      Int
  ownerUserId  Int
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  connection SupportConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  asset      ContentAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerUser  User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([connectionId, assetId])
  @@index([ownerUserId, createdAt])
  @@index([assetId])

  @@map("supportsharedasset")
}

model CommunityPost {
  id          Int      @id @default(autoincrement())
  userId      Int
  accountId   Int?
  type        String   @db.VarChar(32)
  title       String   @db.VarChar(128)
  content     String   @db.LongText
  platform    String?  @db.VarChar(64)
  sourceUrl   String?  @db.VarChar(512)
  assetId     Int?
  status      String   @default("published") @db.VarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  asset     ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  comments  CommunityComment[]
  reactions CommunityReaction[]

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([assetId])

  @@map("communitypost")
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  accountId Int?
  content   String   @db.VarChar(512)
  createdAt DateTime @default(now())

  post    CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([userId, createdAt])

  @@map("communitycomment")
}

model CommunityReaction {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  accountId Int?
  kind      String   @db.VarChar(16)
  createdAt DateTime @default(now())

  post    CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([postId, userId, kind])
  @@index([postId, kind])
  @@index([userId, createdAt])

  @@map("communityreaction")
}

model ExplosionCase {
  id              Int      @id @default(autoincrement())
  userId          Int
  accountId       Int?
  sourceUrl       String?  @db.VarChar(512)
  sourcePlatform  String?  @db.VarChar(32)
  sourceContent   String?  @db.LongText
  structureJson   String?  @db.LongText
  myVersion       String?  @db.LongText
  myVersionPrompt String?  @db.LongText
  assetId         Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  asset   ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([sourcePlatform])

  @@map("explosioncase")
}

model DailyCheckin {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        String   @db.VarChar(10)         // "2026-04-29"
  mood        String   @db.VarChar(16)          // "energized" | "rushed" | "unsure" | "tired"
  goalKey     String?  @db.VarChar(32)          // "publish" | "new_product" | "convert"
  sourceHint  String?  @db.VarChar(512)         // 昨日联动提示 / AI 建议
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@index([mood])

  @@map("dailycheckin")
}
